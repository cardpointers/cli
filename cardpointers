cmd_help() {
    local CPINK="\e[38;5;171m"
    local CPBLUE="\e[38;5;69m"
    local BOLD="\e[1m"
    local RESET="\e[0m"
    local DESC_COL=40
    if [ -n "${NO_COLOR:-}" ]; then
        CPINK=""
        CPBLUE=""
        RESET=""
        BOLD=""
    fi

    _help_row() {
        local plain="$1"
        local colored="$2"
        local desc="$3"
        local pad=$((DESC_COL - ${#plain} - 1))
        if ((pad < 1)); then
            pad=1
        fi
        printf "%b%*s%s\n" "$colored" "$pad" "" "$desc"
    }

    printf "${BOLD}%bCardPointers%b CLI v${CLI_VERSION}${RESET} — your cards in your terminal\n" "$CPINK" "$RESET"
    echo ""
    printf "${BOLD}%bUsage:%b${RESET} cardpointers ${CPBLUE}<command>${RESET} [options]\n" "$CPINK" "$RESET"
    echo ""
    printf "${BOLD}%bCommands:%b${RESET}\n" "$CPINK" "$RESET"
    _help_row "  login" "  ${CPINK}login${RESET}" "Log in (supports Apple, Google, passkeys, etc)"
    _help_row "  logout" "  ${CPINK}logout${RESET}" "Clear saved credentials"
    _help_row "  status" "  ${CPINK}status${RESET}" "Show account info and connection status"
    _help_row "  recommend <category>" "  ${CPINK}recommend${RESET} ${CPBLUE}<category>${RESET}" "Best card for a purchase category/store"
    _help_row "    --merchant, -m <name>" "    ${CPINK}--merchant, -m${RESET} ${CPBLUE}<name>${RESET}" "Look up by merchant name/URL instead"
    _help_row "    --amount, -a <dollars>" "    ${CPINK}--amount, -a${RESET} ${CPBLUE}<dollars>${RESET}" "Include estimated value"
    _help_row "  cards" "  ${CPINK}cards${RESET}" "List your cards"
    _help_row "    --status, -s <filter>" "    ${CPINK}--status, -s${RESET} ${CPBLUE}<filter>${RESET}" "approved (default), applied, denied, closed, all"
    _help_row "    --bank, -b <name>" "    ${CPINK}--bank, -b${RESET} ${CPBLUE}<name>${RESET}" "Filter by bank name"
    _help_row "  offers" "  ${CPINK}offers${RESET}" "List your offers"
    _help_row "    --status, -s <filter>" "    ${CPINK}--status, -s${RESET} ${CPBLUE}<filter>${RESET}" "active (default), snoozed, redeemed, expired, all"
    _help_row "    --expiring, -e [days]" "    ${CPINK}--expiring, -e${RESET} ${CPBLUE}[days]${RESET}" "Show offers expiring within N days (default: 7)"
    _help_row "    --card, -c <name>" "    ${CPINK}--card, -c${RESET} ${CPBLUE}<name>${RESET}" "Filter by card name"
    _help_row "    --category, -y <name>" "    ${CPINK}--category, -y${RESET} ${CPBLUE}<name>${RESET}" "Filter by category"
    _help_row "    --type, -t <standard|personal>" "    ${CPINK}--type, -t${RESET} ${CPBLUE}<standard|personal>${RESET}" "Filter by offer type"
    _help_row "    --bank, -b <name>" "    ${CPINK}--bank, -b${RESET} ${CPBLUE}<name>${RESET}" "Filter by bank (amex, chase, citi, boa, usbank, wellsfargo)"
    _help_row "    --favorite, -f" "    ${CPINK}--favorite, -f${RESET}" "Show only favorited offers"
    _help_row "    --sort, -r <expiring|value|card>" "    ${CPINK}--sort, -r${RESET} ${CPBLUE}<expiring|value|card>${RESET}" "Sort offers"
    _help_row "  search <query>" "  ${CPINK}search${RESET} ${CPBLUE}<query>${RESET}" "Search your offers by keyword"
    _help_row "    --favorite, -f" "    ${CPINK}--favorite, -f${RESET}" "Show only favorited offers"
    _help_row "  profiles" "  ${CPINK}profiles${RESET}" "List your linked profiles"
    _help_row "  ping" "  ${CPINK}ping${RESET}" "Test MCP connection"
    _help_row "  tools" "  ${CPINK}tools${RESET}" "List available MCP tools"
    _help_row "  completions" "  ${CPINK}completions${RESET}" "Show shell completion setup"
    echo ""
    printf "${BOLD}%bGlobal options:%b${RESET}\n" "$CPINK" "$RESET"
    _help_row "  --profile, -p <value>" "  ${CPINK}--profile, -p${RESET} ${CPBLUE}<value>${RESET}" "Filter by profile (number, name, all)"
    _help_row "  --limit, -l <n>" "  ${CPINK}--limit, -l${RESET} ${CPBLUE}<n>${RESET}" "Limit number of results"
    _help_row "  --json, -j" "  ${CPINK}--json, -j${RESET}" "Output raw JSON instead of formatted text"
    echo ""
    printf "${BOLD}%bEnvironment:%b${RESET}\n" "$CPINK" "$RESET"
    _help_row "  CARDPOINTERS_API" "  ${CPINK}CARDPOINTERS_API${RESET}" "API base URL (default: https://mcp.cardpointers.com)"
    _help_row "  NO_COLOR" "  ${CPINK}NO_COLOR${RESET}" "Disable ANSI colors in output"
}

# ─── Main ─────────────────────────────────────────────────────────

if [ $# -eq 0 ]; then
    cmd_help
    exit 0
fi

case "${1:-}" in
    --version)
        cmd_version
        exit 0
        ;;
esac

command="$1"
shift

case "$command" in
    login)      cmd_login "$@" ;;
    logout)     cmd_logout ;;
    status)     cmd_status ;;
    recommend)  cmd_recommend "$@" ;;
    cards)      cmd_cards "$@" ;;
    offers)     cmd_offers "$@" ;;
    search)     cmd_search "$@" ;;
    profiles)   cmd_profiles "$@" ;;
    ping)       cmd_ping ;;
    tools)      cmd_tools ;;
    completions) cmd_completions "$@" ;;
    help|--help|-h) cmd_help ;;
    *)          die "Unknown command: ${command}. Run: cardpointers help" ;;
esac
